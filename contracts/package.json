{
  "name": "@giroledger/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RuleRegistry and RuleExecutor. Hardhat 3, viem, Solidity tests via forge-std.",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test solidity",
    "test:fork": "hardhat test solidity --config hardhat.fork.config.ts",
    "test:ts": "hardhat test node",
    "deploy": "hardhat ignition deploy ignition/modules/GiroLedger.ts --network coston2",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(solhint not configured yet)\"",
    "clean": "hardhat clean",
    "verify": "hardhat build --build-profile production && hardhat ignition verify giroledger-v2 --network coston2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@nomicfoundation/hardhat-verify": "^3.0.21",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/node": "catalog:",
    "forge-std": "foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.11.1",
    "typescript": "catalog:",
    "viem": "catalog:"
  }
}
